{
  "name": "easy-sankey",
  "version": "2.0.4",
  "description": "A finance management tool for tracking expenses and managing budgets. Easy Sankey helps you create clear and simple financial visualisations without the need for Excel or technical skills. Just a few easy inputs, and you can see where your money goes!",
  "author": "Long Nguyen",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/start-dev.cjs",
    "start-server": "node server.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron-build": "npm run build && electron .",
    "spell-check": "cspell \"src/**/*.ts\" \"src/**/*.html\"",
    "circular-check": "npx madge --circular --extensions ts ./",
    "deploy-mac": "node scripts/deploy-mac.js",
    "deploy-win": "ng build && electron-builder --win",
    "test:database": "node scripts/test-database.cjs",
    "rebuild:electron": "electron-builder install-app-deps",
    "test:packaged": "node scripts/smoke-packaged.cjs",
    "postinstall": "electron-builder install-app-deps",
    "prebuild": "node scripts/sync-default-categories.cjs",
    "dev:serve": "ng serve --host 127.0.0.1 --port 4200"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "arima": "^0.2.5",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "echarts": "^5.5.1",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "material-symbols": "^0.24.0",
    "mathjs": "^13.2.1",
    "ml-regression-polynomial": "^3.0.1",
    "ngx-echarts": "^18.0.0",
    "ngx-mat-select-search": "^9.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@cspell/dict-en-gb": "^4.1.51",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.7.5",
    "autoprefixer": "^10.4.20",
    "cspell": "^8.16.0",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.easy-sankey.app",
    "productName": "Easy Sankey",
    "publish": {
      "provider": "github",
      "owner": "LongNguyen159",
      "repo": "finance-management",
      "private": true
    },
    "files": [
      "dist/easy-sankey/**/*",
      "main.js",
      "preload.js",
      "electron/storage/**/*.js",
      "!electron/storage/**/*.test.js",
      "electron/storage/*.json"
    ],
    "directories": {
      "output": "releases/v${version}/${platform}/${arch}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/mac/easy-sankey-512-3d.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/win/easy-sankey-512-3d.ico"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
