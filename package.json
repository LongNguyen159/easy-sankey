{
  "name": "easy-sankey",
  "version": "2.0.4",
  "description": "A finance management tool for tracking expenses and managing budgets. Easy Sankey helps you create clear and simple financial visualisations without the need for Excel or technical skills. Just a few easy inputs, and you can see where your money goes!",
  "author": "Long Nguyen",
  "main": ".electron-dist/main.cjs",
  "scripts": {
    "start": "node scripts/start-dev.cjs",
    "deploy-mac": "node scripts/deploy-mac.js",
    "orm:migrate": "prisma migrate dev",
    "test": "node scripts/verify.cjs test",
    "check": "node scripts/verify.cjs check",
    "ng": "ng",
    "orm:studio": "prisma studio"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "arima": "^0.2.5",
    "better-sqlite3": "13.2.0",
    "cors": "^2.8.5",
    "echarts": "^6.1.0",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "material-symbols": "^0.49.0",
    "mathjs": "^15.3.0",
    "ml-regression-polynomial": "^3.0.1",
    "ngx-echarts": "^22.0.0",
    "ngx-mat-select-search": "^9.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.0.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@cspell/dict-en-gb": "^4.1.51",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.7.5",
    "cspell": "^8.16.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.47",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.easy-sankey.app",
    "productName": "Easy Sankey",
    "publish": {
      "provider": "github",
      "owner": "LongNguyen159",
      "repo": "finance-management",
      "private": true
    },
    "files": [
      "dist/easy-sankey/**/*",
      ".electron-dist/**/*",
      "prisma/migrations/**/*"
    ],
    "directories": {
      "output": "releases/v${version}/${platform}/${arch}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/mac/easy-sankey-512-3d.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/win/easy-sankey-512-3d.ico"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
