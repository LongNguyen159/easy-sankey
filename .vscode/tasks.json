{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: Angular server",
      "type": "npm",
      "script": "dev:serve",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*127\\.0\\.0\\.1:4200"
        }
      }
    }
  ]
}
