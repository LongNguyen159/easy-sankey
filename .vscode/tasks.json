{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: Angular server",
      "type": "shell",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*127\\.0\\.0\\.1:4200"
        }
      },
      "command": "node scripts/build-electron.cjs && npx ng serve --host 127.0.0.1 --port 4200"
    }
  ]
}
