{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Easy Sankey: development",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [
        ".",
        "--dev"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev: Angular server",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
